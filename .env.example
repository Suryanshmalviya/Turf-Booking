# Local development environment.
# Generated from .env.example. Git-ignored: never commit this file.
# The two JWT secrets below were randomly generated for this machine.

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

MONGODB_URI=mongodb://localhost:27017/pickleball_booking

# 96 hex characters each (48 random bytes). Regenerate per environment.
JWT_SECRET=8c6daf92da5d4304433d426b924797216dcb287c3e879744eb3cec7c171c9382f778f0612511fedfbd03e46a769f2796
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dc2dc3d9d5b1dee82228437e1d06d548aa10cc8ef5bbd215236f97a2763c62421d9ac738d32d4dd3e081e9474873e6a0
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_ACCESS_COOKIE_NAME=pb_access
AUTH_REFRESH_COOKIE_NAME=pb_refresh
AUTH_CSRF_COOKIE_NAME=pb_csrf
AUTH_ACCESS_COOKIE_MAX_AGE_MS=900000
AUTH_REFRESH_COOKIE_MAX_AGE_MS=604800000

# Off for local development: there is no SMTP server, so a verification link
# would only ever reach the API log. Turning this on makes register -> sign-in
# require clicking that logged link. The test suite pins its own value, so this
# does not affect `npm test`.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

ADMIN_EMAIL=admin@pickleball.com
ADMIN_PASSWORD=Admin@12345

PAYMENT_PROVIDER=development_mock
PAYMENT_WEBHOOK_SECRET=local-development-webhook-secret
PAYMENT_PENDING_TIMEOUT_MINUTES=30

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@pickleball-booking.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=pickleball-booking-uploads

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_WRITE_MAX_REQUESTS=60
RATE_LIMIT_PASSWORD_RECOVERY_MAX_REQUESTS=5

LOG_LEVEL=debug
LOG_FORMAT=pretty

SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_DISPLAY_NAME=Test Owner
SEED_OWNER_PASSWORD_HASH=
SEED_VENUE_NAME=Test Venue
SEED_VENUE_DESCRIPTION=
SEED_VENUE_TIMEZONE=UTC
SEED_VENUE_ADDRESS_LINE1=
SEED_VENUE_CITY=
SEED_VENUE_REGION=
SEED_VENUE_POSTAL_CODE=
SEED_VENUE_COUNTRY=US