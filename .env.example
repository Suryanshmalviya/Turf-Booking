# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# ─── Database ───────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017

# ─── Authentication ─────────────────────────────────────────────────────────
# Replace BOTH secrets with random values of at least 32 characters.
JWT_SECRET=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiYWRtaW4iOnRydWUsImlhdCI6MTUxNjIzOTAyMn0.KMUFsIDTnFmyG3nMiGM6H9FNFUROf3wh7SmqJp-QV30
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiYWRtaW4iOnRydWUsImlhdCI6MTUxNjIzOTAyMn0.KMUFsIDTnFmyG3nMiGM6H9FNFUROf3wh7SmqJp-QV30
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ─── Cookie Settings ────────────────────────────────────────────────────────
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_ACCESS_COOKIE_NAME=pb_access
AUTH_REFRESH_COOKIE_NAME=pb_refresh
AUTH_CSRF_COOKIE_NAME=pb_csrf
AUTH_ACCESS_COOKIE_MAX_AGE_MS=900000
AUTH_REFRESH_COOKIE_MAX_AGE_MS=604800000

# ─── Account verification & recovery ─────────────────────────────────────────
# When true, registration creates an unverified account and sign-in is refused
# until the address is confirmed. Bootstrap/seeded accounts are trusted and skip
# the check. Turning this off is only appropriate for closed environments.
AUTH_REQUIRE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# ─── Admin bootstrap ────────────────────────────────────────────────────────
# The platform administrator account. Override these in production.
ADMIN_EMAIL=admin@pickleball.com
ADMIN_PASSWORD=Admin@12345

# ─── Payments ───────────────────────────────────────────────────────────────
# No live provider is selected by default. The development mock only creates
# pending attempts and accepts locally HMAC-signed test webhooks.
PAYMENT_PROVIDER=unselected
PAYMENT_WEBHOOK_SECRET=replace-with-a-local-webhook-signing-secret
PAYMENT_PENDING_TIMEOUT_MINUTES=30

# Stripe placeholders (only used once a Stripe adapter is implemented)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ─── Email (placeholder) ────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@pickleball-booking.com

# ─── File Upload (placeholder - e.g. AWS S3) ─────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=pickleball-booking-uploads

# ─── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_WRITE_MAX_REQUESTS=60
# Recovery endpoints only send mail, so the budget stays small.
RATE_LIMIT_PASSWORD_RECOVERY_MAX_REQUESTS=5

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=json

# ─── Seeding (optional, used by `npm run db:seed`) ───────────────────────────
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_DISPLAY_NAME=Test Owner
SEED_OWNER_PASSWORD_HASH=
SEED_VENUE_NAME=Test Venue
SEED_VENUE_DESCRIPTION=
SEED_VENUE_TIMEZONE=UTC
SEED_VENUE_ADDRESS_LINE1=
SEED_VENUE_CITY=
SEED_VENUE_REGION=
SEED_VENUE_POSTAL_CODE=
SEED_VENUE_COUNTRY=US

# ─── Web (Vite) ─────────────────────────────────────────────────────────────
# Optional. When unset the web client calls the same origin (/api/v1), which is
# what the Vite dev proxy expects. Set this for split-origin deployments.
# VITE_API_URL=https://api.example.com/api/v1
